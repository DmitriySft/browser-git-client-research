# Copy to .env.local (ignored by Git) and fill in. Restart `npm run dev` after changes.

# Customer proxy base URL. Defaults to the deployed debugging instance.
# VITE_PROXY_URL=https://git-proxy-wpnzxfaym7kcs.gentlepond-06cb06de.newzealandnorth.azurecontainerapps.io

# Name of the proxy's oauthClients entry in proxy/settings.json.
VITE_OAUTH_CLIENT=github

# Public client ID of the GitHub App or OAuth App (not the secret).
# Defaults to the research OAuth App (Ov23liYk4IDSqiJp0v9W).
# VITE_OAUTH_CLIENT_ID=

# Defaults to "repo", which GitHub OAuth Apps need for private repositories.
# Set to an empty value for GitHub Apps, which use the App's repository permissions.
# VITE_OAUTH_SCOPE=

# Optional repository URL prefilled in the demo page.
VITE_DEMO_REPO_URL=
